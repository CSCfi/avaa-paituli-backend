{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/*.env*)",
      "Edit(**/*.env*)",
      "Bash(*.env*)",
      "Bash(env)",
      "Bash(printenv)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "**/*.env*"
      ]
    }
  }
}
